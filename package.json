{
  "name": "french-learning-platform",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm --prefix server run clean && npm --prefix server run build && npm --prefix client run build",
    "start": "node server/dist/app.js",
    "set-admin": "tsx scripts/set_admin_user.ts",
    "populate:content": "tsx scripts/populate_content.ts",
    "migrate": "tsx scripts/run-migration.ts",
    "db:status": "npm --prefix server run db:status",
    "db:reset": "rimraf database/french_learning.db database/test.sqlite3",
    "db:seed": "npm --prefix server run db:seed",
    "db:setup": "run-s db:rebuild migrate db:seed db:status",
    "db:rebuild": "run-s db:reset"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "ts-node": "^10.9.2",
    "uuid": "^12.0.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.27.1",
    "@types/bcryptjs": "^3.0.0",
    "autoprefixer": "^10.4.21",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.5",
    "prop-types": "^15.8.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.5"
  }
}
