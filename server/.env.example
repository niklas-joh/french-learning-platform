PORT=3001
JWT_SECRET=your-super-secret-jwt-key-here
NODE_ENV=production
DATABASE_URL=./database/french_learning.db
# Optional AI API keys
ADMIN_EMAIL=admin@yourplatform.com
CLAUDE_API_KEY=your-claude-key

# --- AI Services Configuration ---
# Primary AI provider key
OPENAI_API_KEY=your-openai-key

# Fallback AI provider (Claude)
CLAUDE_API_KEY=your-claude-key

# Provider selection (openai|claude)
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_ENABLED=true

# SSL Configuration for Corporate Networks
# Set to 'false' if experiencing SSL certificate issues
AI_SSL_REJECT_UNAUTHORIZED=true

# Redis for Caching and Rate Limiting - DISABLED for database-only operation
REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379

# Database-Only Job Processing Configuration
DB_JOB_QUEUE_ENABLED=true
DB_JOB_POLL_INTERVAL_MS=1000
DB_JOB_MAX_CONCURRENT=5

# AI Usage and Cost Management
AI_BUDGET_MONTHLY=200
AI_RATE_LIMIT_PER_MINUTE=20
