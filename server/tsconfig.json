{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": []
  },
  "include": ["src/**/*", "src/knexfile.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "src/_archive/**/*", "**/__tests__/**/*"],
  "ts-node": {
    "esm": true
  }
}
