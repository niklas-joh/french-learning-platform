{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec npx tsx src/app.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "start": "npx tsx src/app.ts",
    "worker:start": "npx tsx src/worker.ts",
    "worker:dev": "nodemon --exec npx tsx src/worker.ts",
    "clean": "rimraf dist",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "db:migrate": "tsx ../node_modules/.bin/knex migrate:latest --knexfile src/knexfile.ts",
    "db:rollback": "tsx ../node_modules/.bin/knex migrate:rollback --knexfile src/knexfile.ts",
    "db:seed": "tsx ../node_modules/.bin/knex seed:run --knexfile src/knexfile.ts",
    "db:status": "tsx ../node_modules/.bin/knex migrate:list --knexfile src/knexfile.ts",
    "populate:content": "tsx ../scripts/populate_content.ts",
    "doc:api": "typedoc",
    "semgrep": "semgrep --config ../.semgrep.yml --json > ../docs/auto-generated/patterns.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "object-hash": "^3.0.0",
    "objection": "^3.1.5",
    "openai": "^4.104.0",
    "sqlite3": "^5.1.7",
    "uuid": "^12.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/knex": "^0.15.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "@types/object-hash": "^3.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.25.13",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.4.0"
  }
}
