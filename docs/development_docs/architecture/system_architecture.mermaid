%% System Architecture - French Learning Platform
%% Updated: 2025-08-26 - Task 3.2.A.3 - Completed Curriculum API Endpoints
%% Added comprehensive curriculum API endpoints with 98% code reuse architecture
%% 
%% Performance Optimizations Applied (progressService.ts v2.0):
%% - Replaced dynamic imports with factory singleton pattern (~50ms improvement per call)
%% - Full ESM compliance with proper .js extensions
%% - Improved TypeScript type safety (Knex Transaction types)
%% - Consolidated service patterns for consistency

graph TD
    subgraph "Frontend (React + TypeScript)"
        direction TB

        subgraph "State & API Management"
            AuthContext["AuthContext (User, Token, Auth Status)"]
            ApiService["Central API Service (Axios with Interceptors)"]
            useLearningPath["useLearningPath Hook (State for Lessons)"]
            AuthContext --> ApiService
            ApiService --> AuthContext
        end

        subgraph "Core App Screens (Mobile First)"
            direction LR
            HomePage(Home)
            LessonsPage(Lessons)
            PracticePage(Practice)
            ProgressPage(Progress)
            ProfilePage(Profile)
        end

        subgraph "UI Components"
            MainLayout["MainLayout (Mobile Frame)"]
            BottomNav["BottomTabNavigation"]
            LearningPath["LearningPath.tsx"]
            LearningUnit["LearningUnit.tsx"]
            LessonNode["LessonNode.tsx"]
            
            subgraph "Dynamic Lesson Content"
                direction TB
                LessonPage["LessonPage.tsx (Controller)"]
                DynamicContent["DynamicLessonContent.tsx"]
                Suspense["React.Suspense (Loading Boundary)"]
                VocabularyLesson["VocabularyLesson.tsx"]
                GrammarLesson["GrammarLesson.tsx"]
                ConversationLesson["ConversationLesson.tsx"]
                
                LessonPage --> DynamicContent
                DynamicContent --> Suspense
                Suspense --> VocabularyLesson
                Suspense --> GrammarLesson
                Suspense --> ConversationLesson
            end
        end

        MainLayout --> BottomNav
        MainLayout --> HomePage
        MainLayout --> LessonsPage
        MainLayout --> PracticePage
        MainLayout --> ProgressPage
        MainLayout --> ProfilePage
        
        LessonsPage --> LearningPath
        LearningPath --> LearningUnit
        LearningUnit --> LessonNode
        
        AuthContext -- "Provides auth state" --> MainLayout
        useLearningPath -- "Fetches data via" --> ApiService
        LessonNode -- "Navigates to" --> LessonPage
    end

    subgraph "Backend API (Node.js + Express)"
        direction TB

        ApiGateway["/api/v1"]

        subgraph "Routes"
            UserRoutes["user.routes.ts"]
            LearningRoutes["learning.routes.ts"]
            MetaRoutes["meta.routes.ts"]
            AuthRoutes["auth.routes.ts"]
            AdminRoutes["admin.routes.ts"]
            AIRoutes["ai.routes.ts (Dashboard + Curriculum Endpoints Added)"]
            AssessmentRoutes["assessment.routes.ts"]
        end

        subgraph "Controllers"
            UserController["user.controller.ts"]
            ProgressController["progress.controller.ts"]
            GamificationController["gamification.controller.ts"]
            LearningPathController["learningPath.controller.ts"]
            AIController["ai.controller.ts (Task 3.2.A.3 Enhanced)"]
            SpeechController["speech.controller.ts"]
            AssessmentController["assessment.controller.ts"]
        end

        subgraph "Services"
            subgraph "Enhanced Progress Service (Task 3.2.A.2) - Performance Optimized v2.0"
                direction TB
                ProgressService["progress.service.ts (Functional + Class patterns)"]
                ProgressAIFeatures["AI Progress Functions (Factory Pattern)"]
                ProgressAIFeatures --> getUserRecentProgress["getUserRecentProgress()"]
                ProgressAIFeatures --> getUserLevel["getUserLevel()"]
                ProgressAIFeatures --> identifyWeakAreas["identifyWeakAreas() - Optimized"]
                ProgressService --> ProgressAIFeatures
                PerformanceOptimizations["Performance Optimizations Applied"]
                PerformanceOptimizations --> FactoryPattern["Factory Singleton Pattern"]
                PerformanceOptimizations --> ESMCompliance["Full ESM Compliance"]
                PerformanceOptimizations --> TypeSafety["Improved Type Safety"]
                ProgressAIFeatures --> PerformanceOptimizations
            end
            
            subgraph "Enhanced Learning Path Service (Task 3.2.A.2)"
                direction TB
                LearningPathService["learningPath.service.ts"]
                CurriculumFeatures["AI Curriculum Functions"]
                CurriculumFeatures --> getAdaptiveLearningRecommendations["getAdaptiveLearningRecommendations()"]
                CurriculumFeatures --> getCachedDailyPlan["getCachedDailyPlan()"]
                CurriculumFeatures --> adaptLearningPath["adaptLearningPath()"]
                LearningPathService --> CurriculumFeatures
            end
            
            GamificationService["gamification.service.ts (placeholder)"]
            SpeechService["speech.service.ts (placeholder)"]
        end

        subgraph "AI Services Layer"
            direction TB
            subgraph "Enhanced AI Orchestrator (Task 3.2.A.3)"
                direction TB
                AIOrchestrator["AIOrchestrator"]
                CurriculumEndpoints["New Curriculum Methods"]
                CurriculumEndpoints --> generateDailyPlan["generateDailyPlan()"]
                CurriculumEndpoints --> adaptLearningPath_AI["adaptLearningPath()"]
                CurriculumEndpoints --> getDailyPlan["getDailyPlan()"]
                CurriculumEndpoints --> getLearningRecommendations["getLearningRecommendations()"]
                AIOrchestrator --> CurriculumEndpoints
            end
            
            subgraph "Assessment Engine"
                direction TB
                AIAssessmentEngine["AIAssessmentEngine"]
                BatchAssessmentProcessor["BatchAssessmentProcessor (Enhanced)"]
                AssessmentStrategyFactory["AssessmentStrategyFactory"]
                
                subgraph "Assessment Services (Refactored)"
                    direction TB
                    AssessmentQueryService["AssessmentQueryService"]
                    AssessmentAnalyticsService["AssessmentAnalyticsService"]
                    AssessmentPersistenceService["AssessmentPersistenceService"]
                    AssessmentServiceFactory["AssessmentServiceFactory"]
                    WeaknessAnalysisService["WeaknessAnalysisService (Task 3.1.C.7)"]
                end

                subgraph "Batch Processing Enhancement (Task 3.1.C.4)"
                    direction TB
                    IBatchAssessmentProcessor["IBatchAssessmentProcessor Interface"]
                    JobQueueIntegration["Job Queue Integration"]
                    EnhancedAnalytics["Enhanced Exercise Analytics"]
                    FrenchLanguageUtils["French Language Utilities"]
                    ExerciseFeedback["Exercise-Level Feedback"]
                end
                
                subgraph "Async Weakness Analysis (Task 3.1.C.7)"
                    direction TB
                    WeaknessAnalysisWorker["WeaknessAnalysisWorker"]
                    WeaknessAnalysisJobQueue["Weakness Analysis Job Queue"]
                    PatternRecognition["French Pattern Recognition"]
                    CEFRAnalysis["CEFR-Level Analysis"]
                    CachedResults["Cached Analysis Results"]
                end
                
                subgraph "Assessment Strategies"
                    direction LR
                    MultipleChoiceStrategy["MultipleChoiceStrategy"]
                    FillInBlankStrategy["FillInBlankStrategy"]
                    OpenEndedStrategy["OpenEndedStrategy"]
                    PronunciationStrategy["PronunciationStrategy"]
                    ConversationStrategy["ConversationStrategy"]
                end
            end

            subgraph "Content Generation Engine"
                direction TB
                DynamicContentGenerator["DynamicContentGenerator"]
                DatabaseJobQueueService["DatabaseJobQueueService"]
                
                subgraph "Strategy Pattern Services"
                    direction LR
                    ContentValidatorFactory["ContentValidatorFactory"]
                    ContentEnhancerFactory["ContentEnhancerFactory"]
                    ContentTemplateManager["ContentTemplateManager"]
                end

                subgraph "Content Validators"
                    direction LR
                    LessonValidator["LessonValidator"]
                    VocabularyValidator["VocabularyDrillValidator"]
                    GrammarValidator["GrammarExerciseValidator"]
                    CulturalValidator["CulturalContentValidator"]
                end

                subgraph "Content Enhancers"
                    direction LR
                    LessonEnhancer["LessonEnhancer"]
                    VocabularyEnhancer["VocabularyDrillEnhancer"]
                    GrammarEnhancer["GrammarExerciseEnhancer"]
                    CulturalEnhancer["CulturalContentEnhancer"]
                end
            end
            
            subgraph "Supporting AI Services"
                direction LR
                CacheService["CacheService"]
                RateLimitService["RateLimitService"]
                FallbackHandler["FallbackHandler"]
                ContextService["ContextService"]
                AIMetricsService["AIMetricsService"]
                PromptTemplateEngine["PromptTemplateEngine"]
            end
            
            AIController --> AIOrchestrator
            AssessmentController --> AIAssessmentEngine
            AssessmentController --> BatchAssessmentProcessor
            AssessmentController --> AssessmentAnalyticsService
            AssessmentController --> WeaknessAnalysisService
            
            AIOrchestrator --> AIAssessmentEngine
            AIAssessmentEngine --> AssessmentStrategyFactory
            AIAssessmentEngine --> CacheService
            AIAssessmentEngine --> Database
            
            BatchAssessmentProcessor --> AIAssessmentEngine
            BatchAssessmentProcessor --> AssessmentAnalyticsService
            BatchAssessmentProcessor --> FrenchLanguageUtils
            BatchAssessmentProcessor --> JobQueueIntegration
            AssessmentAnalyticsService --> Database
            
            %% Task 3.1.C.4 Enhanced Integration
            IBatchAssessmentProcessor -.-> BatchAssessmentProcessor
            JobQueueIntegration --> DatabaseJobQueueService
            EnhancedAnalytics --> AssessmentAnalyticsService
            ExerciseFeedback --> FrenchLanguageUtils
            
            %% Task 3.1.C.7 Weakness Analysis Integration
            WeaknessAnalysisWorker --> WeaknessAnalysisService
            WeaknessAnalysisJobQueue --> WeaknessAnalysisWorker
            WeaknessAnalysisService --> AssessmentAnalyticsService
            WeaknessAnalysisService --> FrenchLanguageUtils
            WeaknessAnalysisService --> PromptTemplateEngine
            PatternRecognition --> FrenchLanguageUtils
            CEFRAnalysis --> WeaknessAnalysisService
            CachedResults --> Database
            
            AssessmentStrategyFactory --> MultipleChoiceStrategy
            AssessmentStrategyFactory --> FillInBlankStrategy
            AssessmentStrategyFactory --> OpenEndedStrategy
            AssessmentStrategyFactory --> PronunciationStrategy
            AssessmentStrategyFactory --> ConversationStrategy
            
            PronunciationStrategy --> AIOrchestrator
            OpenEndedStrategy --> PromptTemplateEngine
            ConversationStrategy --> AIOrchestrator

            AIController --> DynamicContentGenerator
            AIOrchestrator --> CacheService
            AIOrchestrator --> RateLimitService
            AIOrchestrator --> FallbackHandler
            AIOrchestrator --> ContextService
            
            %% Task 3.2.A.2 AI Curriculum Integration (Performance Optimized)
            CurriculumFeatures --> AIOrchestrator
            CurriculumFeatures --> CacheService
            ProgressAIFeatures --> AssessmentServiceFactory
            AssessmentServiceFactory --> AssessmentAnalyticsService
            getAdaptiveLearningRecommendations --> AIOrchestrator
            getCachedDailyPlan --> CacheService
            adaptLearningPath --> AIOrchestrator
            identifyWeakAreas --> AssessmentAnalyticsService
            
            DynamicContentGenerator --> AIOrchestrator
            DynamicContentGenerator --> ContentValidatorFactory
            DynamicContentGenerator --> ContentEnhancerFactory
            DynamicContentGenerator --> ContentTemplateManager
            DynamicContentGenerator --> PromptTemplateEngine
            
            ContentValidatorFactory --> LessonValidator
            ContentValidatorFactory --> VocabularyValidator
            ContentValidatorFactory --> GrammarValidator
            ContentValidatorFactory --> CulturalValidator
            
            ContentEnhancerFactory --> LessonEnhancer
            ContentEnhancerFactory --> VocabularyEnhancer
            ContentEnhancerFactory --> GrammarEnhancer
            ContentEnhancerFactory --> CulturalEnhancer
        end
        
        ApiGateway --> AuthRoutes
        ApiGateway --> UserRoutes
        ApiGateway --> LearningRoutes
        ApiGateway --> MetaRoutes
        ApiGateway --> AdminRoutes
        ApiGateway --> AIRoutes
        ApiGateway --> AssessmentRoutes

        UserRoutes --> UserController
        UserRoutes --> ProgressController
        UserRoutes --> GamificationController
        
        LearningRoutes --> LearningPathController
        LearningRoutes --> AIController
        LearningRoutes --> SpeechController
        
        AssessmentRoutes --> AssessmentController

        AIRoutes --> AIController

        MetaRoutes --> GamificationController

        ProgressController --> ProgressService
        GamificationController --> GamificationService
        LearningPathController --> LearningPathService
        SpeechController --> SpeechService
        
        %% Task 3.2.A.2 Enhanced Service Connections
        AIController --> CurriculumFeatures
        AIController --> ProgressAIFeatures
    end

    subgraph "Data & External Services"
        direction TB
        Database["Database (SQLite + Knex)"]
        InMemoryCache["In-Memory Cache (Database-Only)"]
        DatabaseJobQueue["Database Job Queue (SQLite)"]
        OpenAI["OpenAI API"]
        
        CacheService --> InMemoryCache
        RateLimitService --> InMemoryCache
        ContextService --> Database
        AIOrchestrator --> OpenAI
        AIAssessmentEngine --> OpenAI
        DynamicContentGenerator --> DatabaseJobQueue
        DatabaseJobQueueService --> Database
    end

    subgraph "Background Processing (Database-Only)"
        direction TB
        DatabaseWorker["Database Polling Worker"]
        JobQueueMonitor["Job Queue Monitor"]
        JobQueueMaintenance["Maintenance Service"]
        
        DatabaseWorker --> DatabaseJobQueue
        JobQueueMonitor --> Database
        JobQueueMaintenance --> Database
    end

    subgraph "External Services & Deployment"
        GitHub["GitHub Repository"]
        Vercel["Vercel Hosting"]
        AI_Tutor["AI Tutor Service (Future)"]
        
        GitHub -- "CI/CD" --> Vercel
        Vercel -- "Serves" --> Frontend
    end

    ApiService -- "Makes calls to" --> ApiGateway
    
    %% Task 3.2.A.3 Curriculum API Endpoints Integration
    CurriculumEndpoints -.-> CurriculumFeatures
    generateDailyPlan -.-> AIOrchestrator
    adaptLearningPath_AI -.-> AIOrchestrator
    getDailyPlan -.-> CacheService
    getLearningRecommendations -.-> CurriculumFeatures
